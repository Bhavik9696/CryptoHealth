# Environment
PORT=5000
NODE_ENV=development

# Supabase
# Find these at: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx

# JWT Secret
# Find at: Supabase Dashboard → Settings → API → JWT Settings
JWT_SECRET=your_supabase_jwt_secret

# Storage
STORAGE_BUCKET=medical-reports

# Frontend
FRONTEND_URL=http://localhost:5173

# Encryption (server-managed master key for MVP DEK wrapping)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=generate_a_64_char_hex_key_here
