# ============================================================
# CryptoHealth Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# App
APP_NAME=Crypto Health API
APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Supabase (required in production, optional in development)
# Find these at: Supabase Dashboard → Settings → API
# ============================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=medical-reports

# ============================================================
# AES-256-GCM Encryption Key (REQUIRED IN PRODUCTION)
# Must be a 64-character hex string (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: If this is not set in production the server will
# refuse to start. In development an ephemeral key is
# auto-generated with a console warning — data encrypted in
# that session will be unrecoverable after restart.
# ============================================================
ENCRYPTION_KEY=replace_with_64_char_hex_string_generated_by_command_above

# ============================================================
# Ed25519 Signing Keys (REQUIRED IN PRODUCTION)
# Used to sign and verify medical report integrity.
# Generate both keys with:
#   node -e "
#     const c = require('crypto');
#     const k = c.generateKeyPairSync('ed25519', {
#       publicKeyEncoding:  { type: 'spki',  format: 'pem' },
#       privateKeyEncoding: { type: 'pkcs8', format: 'pem' }
#     });
#     console.log('SIGNING_PRIVATE_KEY=' + JSON.stringify(k.privateKey));
#     console.log('SIGNING_PUBLIC_KEY='  + JSON.stringify(k.publicKey));
#   "
# Paste the output below (the JSON.stringify keeps newlines as \n).
#
# WARNING: If not set in production, ephemeral keys are used.
# All signatures from the previous session become unverifiable
# after a server restart.
# ============================================================
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
